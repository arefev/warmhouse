@startuml SmartHomeContainer
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

AddElementTag("microService", $shape=EightSidedShape(), $bgColor="CornflowerBlue", $fontColor="white", $legendText="micro service\neight sided")
AddElementTag("storage", $shape=RoundedBoxShape(), $bgColor="lightSkyBlue", $fontColor="white")

SHOW_PERSON_OUTLINE()

Person(authUser, "Authorized User", "Authorized User system")

System_Boundary(smartHome, "SmartHome"){
    Container(webApp, "Single Page Application", "ReactJS", "")
    Container(userManager, "User manager", "Go", "API for manage users", $tags = "microService")
    Container(deviceManager, "Device manager", "Go", "API for manage user devices", $tags = "microService")
    ContainerDb(appDB, "Application database", "PostgreSQL", "Stores info about users and their devices", $tags = "storage")
    Container(bus, "Device Message Bus", "RabbitMQ", "Transport events between application and devices")
    Container(deviceService, "Device service", "Go", "Service for get data from devices and send actions", $tags = "microService")
}

Rel_D(authUser, webApp, "Uses", "HTTPS")
Rel_D(webApp, userManager, "Uses", "HTTPS")
Rel_D(webApp, deviceManager, "Uses", "HTTPS")
Rel(userManager, appDB, "Stores user data in")
Rel(deviceManager, appDB, "Stores device data in")
Rel(deviceManager, bus, "Send device update events to")

System_Ext(device_1, "Device 1", "Device 1")
System_Ext(device_2, "Device 2", "Device 2")
System_Ext(device_n, "Device ...n", "Device ...n")

Rel(deviceService, bus, "Send device update events to")
Rel(deviceService, device_1, "Get info from device and send action")
Rel(deviceService, device_2, "")
Rel(deviceService, device_n, "")

SHOW_LEGEND()
@enduml